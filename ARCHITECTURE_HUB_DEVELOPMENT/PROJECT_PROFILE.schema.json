{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PROJECT_PROFILE.schema.json",
  "title": "Architecture Hub Project Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "title",
    "summary",
    "human_outcome",
    "users",
    "scope",
    "inputs",
    "outputs",
    "mutation_mode",
    "data_sensitivity",
    "external_dependencies",
    "human_gates",
    "automation_preference",
    "recovery",
    "success_criteria",
    "constraints",
    "risks",
    "open_decisions",
    "status",
    "confirmed_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "project_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$" },
    "title": { "type": "string", "minLength": 3 },
    "summary": { "type": "string", "minLength": 10 },
    "human_outcome": { "type": "string", "minLength": 5 },
    "users": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["in_scope", "out_of_scope"],
      "properties": {
        "in_scope": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
        "out_of_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "inputs": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "outputs": { "type": "array", "items": { "$ref": "#/$defs/artifact" }, "minItems": 1 },
    "mutation_mode": { "enum": ["READ_ONLY", "PROPOSE_ONLY", "HUMAN_APPROVED_WRITE", "BOUNDED_AUTOMATIC_WRITE"] },
    "data_sensitivity": { "enum": ["PUBLIC", "INTERNAL", "PERSONAL", "CONFIDENTIAL", "HIGH_RISK", "UNKNOWN"] },
    "external_dependencies": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "human_gates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "automation_preference": { "enum": ["HUMAN_LED", "ASSISTED", "AUTOMATED_WITH_GATES", "UNKNOWN"] },
    "recovery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repeat_expected", "idempotency_required", "rollback_required", "resume_required"],
      "properties": {
        "repeat_expected": { "type": "boolean" },
        "idempotency_required": { "type": "boolean" },
        "rollback_required": { "type": "boolean" },
        "resume_required": { "type": "boolean" }
      }
    },
    "success_criteria": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1 },
    "constraints": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "risks": { "type": "array", "items": { "$ref": "#/$defs/risk" } },
    "open_decisions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "assumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "status": { "enum": ["DRAFT", "CONFIRMED"] },
    "confirmed_at": { "type": ["string", "null"], "format": "date-time" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "description"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "location": { "type": ["string", "null"] }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["risk", "impact", "handling"],
      "properties": {
        "risk": { "type": "string", "minLength": 1 },
        "impact": { "enum": ["LOW", "MEDIUM", "HIGH", "CRITICAL", "UNKNOWN"] },
        "handling": { "type": "string", "minLength": 1 }
      }
    }
  }
}
