{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ASSEMBLY_MANIFEST.schema.json",
  "title": "Architecture Hub Assembly Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "project_id",
    "profile_ref",
    "library_revision",
    "architecture_level",
    "development_level",
    "selection_decisions",
    "files",
    "next_agent",
    "validation",
    "status",
    "confirmed_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "manifest_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,127}$" },
    "project_id": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9_-]{2,63}$" },
    "profile_ref": { "type": "string", "minLength": 1 },
    "library_revision": { "type": "string", "minLength": 1 },
    "architecture_level": { "enum": ["A1", "A2", "A3", "A4"] },
    "development_level": { "enum": ["D1", "D2", "D3", "D4"] },
    "selection_decisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "decision", "reason", "authority"],
        "properties": {
          "subject": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["SELECTED", "REJECTED", "DEFERRED", "GAP"] },
          "reason": { "type": "string", "minLength": 1 },
          "authority": { "type": "string", "minLength": 1 }
        }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_root", "source", "target", "required", "purpose"],
        "properties": {
          "source_root": { "enum": ["LIBRARY", "HUB_DEVELOPMENT"] },
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "purpose": { "type": "string", "minLength": 1 },
          "source_sha256": { "type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$" },
          "replacements": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        }
      }
    },
    "next_agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent_file", "startprompt", "expected_takeover_state"],
      "properties": {
        "agent_file": { "type": "string", "minLength": 1 },
        "startprompt": { "type": "string", "minLength": 1 },
        "expected_takeover_state": { "const": "TAKEOVER_ACCEPTED" }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stringency_required", "diff_required", "external_session_required"],
      "properties": {
        "stringency_required": { "type": "boolean" },
        "diff_required": { "type": "boolean" },
        "external_session_required": { "type": "boolean" },
        "accepted_gaps": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "status": { "enum": ["DRAFT", "HUMAN_CONFIRMED", "BUILDABLE", "BUILT", "READY_FOR_HANDOVER"] },
    "confirmed_at": { "type": ["string", "null"], "format": "date-time" }
  }
}
